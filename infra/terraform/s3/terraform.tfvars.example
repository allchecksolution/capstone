# Copy to dev.tfvars and fill in the account, region and NEW bucket name.
# 000000000000 is a deliberate placeholder; allowed_account_ids prevents applying it to a real account.
aws_account_id = "000000000000"
aws_region     = "ap-northeast-2"
environment    = "dev"
bucket_name    = "allcheck-dev-private-media-000000000000"

# aws_profile       = "your-project-profile"
# No deployed backend role yet: leave this unset during local development.
# backend_role_name = "your-existing-backend-execution-role"
# allowed_cors_origins = ["https://admin.example.com"]

# aws_profile authenticates Terraform only; configure backend AWS credentials separately.
# With no backend_role_name, the policy is created but is not attached to a principal.
# Do not put access keys or session tokens in this file.
