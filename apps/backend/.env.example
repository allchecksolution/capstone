# ALLCHECK backend local environment
# Copy to `.env` (git-ignored) and fill in the values: cp .env.example .env
# Never commit real values. Share KAKAO_APP_ID / NTS_SERVICE_KEY through the team's private channel.
#
# DB settings are intentionally omitted: the `local` profile (default) already points to
# jdbc:postgresql://localhost:15432/allcheck, and compose.local.yml overrides the URL for containers.

# [Required] Base64-encoded HS256 signing key, decoded length >= 32 bytes. Generate one per developer:
#   Git Bash:   openssl rand -base64 32
#   PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=

# [Needed once feat/ACK-30-identity-domain is merged; unused on main]
# Numeric app ID of the team's Kakao app (Kakao Developers > App > 앱 ID), not the native app key.
KAKAO_APP_ID=

# [Needed once feat/ACK-30-identity-domain is merged; unused on main]
# data.go.kr service key for the NTS business registration validation API.
NTS_SERVICE_KEY=
