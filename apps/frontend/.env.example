# ALLCHECK frontend (Flutter) local defines
# Copy to `.env` (git-ignored): cp .env.example .env
# Run from apps/frontend/admin or apps/frontend/driver:
#   flutter run --dart-define-from-file=../.env
# IntelliJ: add `--dart-define-from-file=../.env` to "Additional run args".
#
# WARNING: every value here is compiled into the app and can be extracted from it.
# Never put backend secrets (JWT_SECRET, NTS_SERVICE_KEY, DB passwords) in this file.
# Do not add inline `# comments` after a value; use separate comment lines.

# Backend base URL. Leave empty to run the app without a server.
# Android emulator cannot reach the host via 127.0.0.1; use http://10.0.2.2:8080/api/v1 instead.
# A physical device needs the PC's LAN IP.
API_BASE_URL=http://127.0.0.1:8080/api/v1

# Kakao native app key (32 hex characters) of the team's Kakao app. Driver app only.
# Register package name kr.allcheck.flutter.driver and your own debug key hash in Kakao Developers.
KAKAO_NATIVE_APP_KEY=

# Shows the "개발용으로 입장" button in debug builds (default: true).
ALLCHECK_DEV_ACCESS=true

# Shows the temporary "관리자 검토 건너뛰기" button in every build type (default: true).
ALLCHECK_TEMP_REVIEW_ACCESS=true

# Enables Firebase push notifications (default: false). Requires Firebase config files.
ALLCHECK_PUSH_ENABLED=false
